# Copy to .env and adjust. docker compose reads .env automatically.

# Shared HMAC secret for signing JWTs (auth-service) and verifying them (api-gateway).
# Must be at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# PostgreSQL superuser used by the init script to create one database per service.
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce

# Payment simulator: charges above this amount are declined (lets you demo the
# compensation path without a real card). Set to 0 to disable.
PAYMENT_DECLINE_ABOVE=5000

# Optional: real Stripe test-mode key. When empty, payment-service uses its simulator.
STRIPE_SECRET_KEY=

# Where the browser reaches the API gateway.
NEXT_PUBLIC_API_URL=http://localhost:8080
